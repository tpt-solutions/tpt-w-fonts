#
# systemd user unit for the tray process. Install to ~/.config/systemd/user/ (or the packaged
# location) and enable with: systemctl --user enable --now tpt-fonts-tray.service
#
# ExecStop runs after the tray has stopped, at logout or when the unit is stopped, and deactivates
# any session fonts it left recorded. Without this unit, the tray's XDG autostart entry is used and
# cleanup depends on the next launch's recovery.

[Unit]
Description=tpt-fonts tray: session font activation
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/tpt-fonts-tray
ExecStop=/usr/bin/tpt-fonts-tray --cleanup
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
